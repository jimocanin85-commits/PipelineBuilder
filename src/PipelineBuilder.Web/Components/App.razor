<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <title>PipelineBuilder - Azure DevOps pipelines</title>
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    @* Applies a theme chosen earlier before the page is drawn, so it does not flash. *@
    <script>try { var theme = localStorage.getItem('pipelinebuilder-theme'); if (theme) document.documentElement.dataset.theme = theme; } catch (e) { }</script>
    <ImportMap />
    <HeadOutlet />
</head>
<body>
    <Routes />
    <script src="@Assets["js/download.js"]"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>
</html>
