<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <title>PipelineBuilder - Azure DevOps pipelines</title>
    <ResourcePreloader />
    <link rel="icon" type="image/svg+xml" href="@Assets["favicon.svg"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    @* Applies a theme chosen earlier before the page is drawn, so it does not flash. *@
    <script src="@Assets["js/theme.js"]"></script>
    @* No import map: it would be a script written into the page, which the Content-Security-Policy does not run. The app imports no modules. *@
    <HeadOutlet />
</head>
<body>
    <Routes />
    <script src="@Assets["js/download.js"]"></script>
    <script src="@Assets["js/live.js"]"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>
</html>
