@inject WizardState Wizard
@inject IJSRuntime JS

<h2>Your pipeline file</h2>
@if (Wizard.BlockingErrors.Count > 0)
{
    <div class="generation-error">
        <p class="severity-error">Fix these settings first:</p>
        <IssueList Issues="Wizard.BlockingErrors" ShowGoTo="true" />
    </div>
}
else if (Pipeline is { } result)
{
    var issues = result.ValidationResults.OrderByDescending(v => v.Severity).ToList();
    if (issues.Count > 0)
    {
        <IssueList Issues="issues" ShowGoTo="true" />
    }

    <div class="file">
        <div class="file-head">
            <span>@PipelineFileName</span>
            <span class="actions">
                <button type="button" class="btn-primary" id="download-yaml" @onclick="() => Download(PipelineFileName, result.Yaml, YamlMime)">Download</button>
                <button type="button" class="btn-secondary" id="copy-yaml" @onclick="() => Copy(result.Yaml)">@(_copied ? "Copied" : "Copy")</button>
            </span>
        </div>
        <YamlView Yaml="@result.Yaml" />
    </div>

    <ol class="next">
        <li>Commit the file as <code>@PipelineFileName</code> in your repository.</li>
        <li>In Azure DevOps: Pipelines → New pipeline → Existing Azure Pipelines YAML file.</li>
        <li>Create what is listed under "Needs in Azure DevOps", and tick each one off.</li>
    </ol>

    <div class="actions">
        <button type="button" class="btn-secondary" id="download-settings" @onclick="DownloadSettings">Save settings</button>
        <span class="hint">To change the pipeline later, open this file on the first step.</span>
    </div>

    @if (_status != null)
    {
        <p class="status" role="status">@_status</p>
    }
}

@code {
    public const string PipelineFileName = "azure-pipelines.yml";
    private const string YamlMime = "application/x-yaml";

    /// <summary>The generated pipeline, passed in so this step is redrawn whenever it changes.</summary>
    [Parameter] public GeneratedPipeline? Pipeline { get; set; }

    private string? _status;

    /// <summary>The Copy button says "Copied" once it has, until the file changes.</summary>
    private bool _copied;

    protected override void OnParametersSet() => _copied = false;

    private async Task Download(string fileName, string content, string mimeType)
    {
        try
        {
            await JS.InvokeVoidAsync("pipelineBuilder.downloadText", fileName, content, mimeType);
            _status = $"Downloaded {fileName}.";
        }
        catch (JSException ex)
        {
            _status = $"Download failed: {ex.Message}";
        }
    }

    private Task DownloadSettings() =>
        Download(PipelineDefinitionSerializer.FileName, PipelineDefinitionSerializer.ToJson(Wizard.Definition), "application/json");

    private async Task Copy(string content)
    {
        try
        {
            var copied = await JS.InvokeAsync<bool>("pipelineBuilder.copyText", content);
            _copied = copied;
            _status = copied ? "Copied." : "The browser blocked the copy. Select the text instead.";
        }
        catch (JSException ex)
        {
            _status = $"Copy failed: {ex.Message}";
        }
    }
}
