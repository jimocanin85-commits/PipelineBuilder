@inject WizardState Wizard
@inject ITemplateMarketplaceService Marketplace

<h2>Template</h2>

<h3>Start from a template</h3>
<ul class="template-list">
    @foreach (var t in Marketplace.GetAllTemplates())
    {
        var applied = Wizard.Definition.TemplateId == t.Id;
        <li>
            <strong>@t.Name</strong> — @t.Description
            <button type="button" class="btn-secondary" data-template="@t.Id" @onclick="() => Apply(t.Id)">@(applied ? "Applied" : "Apply")</button>
        </li>
    }
</ul>
@if (_message != null)
{
    <div class="info-box">@_message</div>
}

@code {
    private string? _message;

    private void Apply(string templateId)
    {
        _message = Wizard.ApplyTemplate(Marketplace, templateId)
            ? "Template applied. Review the following steps to adjust the details."
            : "Template not found.";
    }
}
