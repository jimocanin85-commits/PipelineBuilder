@inject WizardState Wizard

<h3>Health checks</h3>
<p class="hint">A check runs after each deployment. If the app does not answer, the deployment is rolled back.</p>
@for (var i = 0; i < Wizard.HealthChecks.Count; i++)
{
    var hc = Wizard.HealthChecks[i];
    var id = $"health-{i}";
    <div class="card">
        <label><InputCheckbox @bind-Value="hc.Enabled" /> Enabled</label>
        <Field For="@($"{id}-type")" Label="What to check" Hint="@Explain(hc.HealthCheckType)">
            <InputSelect id="@($"{id}-type")" @bind-Value="hc.HealthCheckType" class="form-control" aria-label="Health check type">
                @foreach (var h in Enum.GetValues<HealthCheckType>())
                {
                    <option value="@h">@Label(h)</option>
                }
            </InputSelect>
        </Field>
        @switch (hc.HealthCheckType)
        {
            case HealthCheckType.HttpEndpoint:
                <Field For="@($"{id}-url")" Label="Address" Hint="{environment} becomes test, preprod or prod.">
                    <InputText id="@($"{id}-url")" @bind-Value="hc.Url" class="form-control" placeholder="https://myapp-{environment}.contoso.com/health" />
                </Field>
                <div class="fields three">
                    <Field For="@($"{id}-status")" Label="Expected status code">
                        <InputNumber id="@($"{id}-status")" @bind-Value="hc.ExpectedStatusCode" class="form-control narrow" />
                    </Field>
                    <Field For="@($"{id}-timeout")" Label="Seconds to wait">
                        <InputNumber id="@($"{id}-timeout")" @bind-Value="hc.TimeoutSeconds" class="form-control narrow" />
                    </Field>
                    <Field For="@($"{id}-retries")" Label="Attempts">
                        <InputNumber id="@($"{id}-retries")" @bind-Value="hc.RetryCount" class="form-control narrow" />
                    </Field>
                </div>
                <p class="hint">The check tries again, because an app can take a moment to start.</p>
                break;
            case HealthCheckType.IisAppPool:
                <Field For="@($"{id}-pool")" Label="App pool">
                    <InputText id="@($"{id}-pool")" @bind-Value="hc.AppPoolName" class="form-control" placeholder="DefaultAppPool" />
                </Field>
                break;
            case HealthCheckType.WindowsService:
                <Field For="@($"{id}-service")" Label="Service name">
                    <InputText id="@($"{id}-service")" @bind-Value="hc.ServiceName" class="form-control" placeholder="W3SVC" />
                </Field>
                break;
            case HealthCheckType.PortCheck:
                <Field For="@($"{id}-port")" Label="Port">
                    <InputNumber id="@($"{id}-port")" @bind-Value="hc.Port" class="form-control narrow" placeholder="80" />
                </Field>
                break;
            case HealthCheckType.CustomPowerShell:
                <Field For="@($"{id}-script")" Label="Script" Hint="The check fails when the script ends with an error.">
                    <InputTextArea id="@($"{id}-script")" @bind-Value="hc.CustomScript" class="form-control" rows="4" />
                </Field>
                break;
        }
        <button type="button" class="btn-link" @onclick="() => { Wizard.HealthChecks.Remove(hc); Wizard.NotifyChanged(); }">Remove</button>
    </div>
}
<button type="button" class="btn-secondary" id="add-health-check" @onclick="Add">Add health check</button>

@code {
    private static string Label(HealthCheckType type) => type switch
    {
        HealthCheckType.HttpEndpoint => "HTTP address",
        HealthCheckType.IisAppPool => "IIS app pool",
        HealthCheckType.WindowsService => "Service",
        HealthCheckType.PortCheck => "Port",
        _ => "Your own script"
    };

    private static string Explain(HealthCheckType type) => type switch
    {
        HealthCheckType.HttpEndpoint => "Calls the address and expects the status code below.",
        HealthCheckType.IisAppPool => "Checks that the app pool is started.",
        HealthCheckType.WindowsService => "Checks that the service is running.",
        HealthCheckType.PortCheck => "Checks that something answers on the port.",
        _ => "Runs your script on the server."
    };

    private void Add()
    {
        Wizard.HealthChecks.Add(new HealthCheckConfig { Enabled = true, HealthCheckType = HealthCheckType.HttpEndpoint });
        Wizard.NotifyChanged();
    }
}
