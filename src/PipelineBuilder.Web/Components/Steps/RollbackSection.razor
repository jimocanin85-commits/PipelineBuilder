@inject WizardState Wizard
@inject IDeploymentKinds DeploymentKinds

<h3>Rollback</h3>
@{
    var kind = DeploymentKinds.For(Wizard.Definition.Deployment.Kind);
    var onServers = kind.RunsOnServers;
}
@if (!kind.SupportsRollback)
{
    <p class="hint">Rollback is up to your playbook, for example with block and rescue. The pipeline stops at the environment that failed.</p>
}
else
{
    <label class="check">
        <InputCheckbox id="rollback-enabled" @bind-Value="Wizard.Definition.Rollback.Enabled" />
        @(onServers ? "Back up before deploying, and roll back if the deployment fails" : "Roll back if the deployment fails")
    </label>
    <p class="hint">@(onServers
        ? "The running version is saved first. If a step fails, it is put back, so the servers are left as they were."
        : "If a step fails, the cluster goes back to the version that ran before.")</p>
}
@if (kind.SupportsRollback && Wizard.Definition.Rollback.Enabled)
{
    @* Your own script does not say what it deploys, so the user chooses what to back up. *@
    if (kind.RollbackTarget is null)
    {
        <Field For="rollback-target" Label="What your script deploys" Hint="Decides what is backed up and how it is put back.">
            <InputSelect id="rollback-target" @bind-Value="Wizard.Definition.Rollback.Target" class="form-control">
                @foreach (var target in Enum.GetValues<RollbackTarget>())
                {
                    <option value="@target">@Label(target)</option>
                }
            </InputSelect>
        </Field>
    }
    if (onServers)
    {
        <div class="fields">
            <Field For="backup-path" Label="Backup folder on the server" Hint="Empty means D:\backups on Windows and /var/backups/pipelinebuilder on Linux.">
                <InputText id="backup-path" @bind-Value="Wizard.Definition.Rollback.BackupPath" class="form-control" />
            </Field>
            <Field For="retention" Label="Backups to keep per environment" Hint="Older backups are deleted.">
                <InputNumber id="retention" @bind-Value="Wizard.Definition.Rollback.RetentionCount" class="form-control narrow" />
            </Field>
        </div>
    }
    <Field For="rollback-script" Label="Your own rollback command (optional)" Hint="Runs instead of the built-in rollback.">
        <InputText id="rollback-script" @bind-Value="Wizard.Definition.Rollback.RollbackScript" class="form-control" placeholder="scripts/rollback.cmd" />
    </Field>
}

@code {
    private static string Label(RollbackTarget target) => target switch
    {
        RollbackTarget.Iis => "An IIS website",
        RollbackTarget.WindowsService => "A Windows service",
        RollbackTarget.LinuxService => "A Linux service",
        RollbackTarget.FileShare => "Files in a folder",
        RollbackTarget.DockerContainer => "A Docker container",
        _ => "A Kubernetes deployment"
    };
}
