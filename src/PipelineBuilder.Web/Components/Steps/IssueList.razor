@inject WizardState Wizard

@if (Issues.Count > 0)
{
    <ul class="issue-list">
        @foreach (var issue in Issues)
        {
            var step = StepMap.ForField(issue.AffectedField);
            <li class="severity-@issue.Severity.ToString().ToLowerInvariant()">
                <strong>@issue.Severity:</strong> @issue.Message
                @if (!string.IsNullOrWhiteSpace(issue.SuggestedFix))
                {
                    <div class="hint">Fix: @issue.SuggestedFix</div>
                }
                @if (ShowGoTo && step is { } target && target != Wizard.CurrentStep)
                {
                    <button type="button" class="btn-link go-to-step" data-go-to="@target" @onclick="() => Wizard.RequestNavigation(target)">
                        Go to step @((int)target): @StepTitles.For(target)
                    </button>
                }
            </li>
        }
    </ul>
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<ValidationResult> Issues { get; set; } = Array.Empty<ValidationResult>();

    /// <summary>Show a "Go to step" link for issues that belong to another step.</summary>
    [Parameter] public bool ShowGoTo { get; set; }
}
