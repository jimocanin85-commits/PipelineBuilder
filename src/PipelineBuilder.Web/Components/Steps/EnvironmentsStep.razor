@inject WizardState Wizard
@inject IEnvironmentYamlService EnvironmentService

<h2>Environments</h2>
<label for="environments">Environments, in deployment order (comma-separated)</label>
<InputText id="environments" @bind-Value="Wizard.EnvironmentsCsv" class="form-control" placeholder="test, preprod, prod" />
<p class="hint">Use lowercase letters, digits and hyphens.</p>
<label for="release-branch">Release branch</label>
<InputText id="release-branch" @bind-Value="Wizard.Definition.ReleaseBranch" class="form-control" placeholder="main" />
<p class="hint">Deployments to <code>prod</code> or <code>production</code> only run from this branch.</p>
<div class="info-box">@EnvironmentService.GetApprovalUiNote()</div>

<h3>Trigger</h3>
<label><InputCheckbox @bind-Value="Wizard.Definition.Trigger.TriggerAll" /> Run on every branch</label>
@if (!Wizard.Definition.Trigger.TriggerAll)
{
    <label for="include-branches">Branches (comma-separated, wildcards allowed)</label>
    <InputText id="include-branches" @bind-Value="Wizard.IncludeBranches" class="form-control" placeholder="main, release/*" />
}
<label for="exclude-branches">Excluded branches</label>
<InputText id="exclude-branches" @bind-Value="Wizard.ExcludeBranches" class="form-control" placeholder="release/old" />
<label for="path-filters">Path filters (prefix with ! to exclude)</label>
<InputText id="path-filters" @bind-Value="Wizard.PathFilters" class="form-control" placeholder="src/*, !docs/*" />
