@inject WizardState Wizard

<h2>Artifacts</h2>
<label for="artifact-type">Package as</label>
<InputSelect id="artifact-type" @bind-Value="Wizard.Definition.Artifact.ArtifactType" class="form-control">
    @foreach (var a in Enum.GetValues<ArtifactType>())
    {
        <option value="@a">@a</option>
    }
</InputSelect>

<label for="artifact-name">@(Wizard.Definition.Artifact.ArtifactType == ArtifactType.DockerImage ? "Image repository name" : "Artifact name")</label>
<InputText id="artifact-name" @bind-Value="Wizard.Definition.Artifact.ArtifactName" class="form-control" />

@switch (Wizard.Definition.Artifact.ArtifactType)
{
    case ArtifactType.DockerImage:
        <label for="dockerfile">Dockerfile</label>
        <InputText id="dockerfile" @bind-Value="Wizard.Definition.Artifact.PackagePath" class="form-control" placeholder="**/Dockerfile" />
        <p class="hint">Images are tagged with the build ID and pushed through the registry connection set on the Identity step.</p>
        break;
    case ArtifactType.NuGetPackage:
        <label for="pack-projects">Projects to pack</label>
        <InputText id="pack-projects" @bind-Value="Wizard.Definition.Artifact.PackagePath" class="form-control" placeholder="**/*.csproj;!**/*Tests*.csproj" />
        <p class="hint">Packages are pushed to the feed in the <code>NUGET_FEED</code> variable.</p>
        break;
    default:
        <p class="hint">The app is published with <code>dotnet publish</code> and uploaded as the artifact; deploy jobs download it automatically.</p>
        break;
}
