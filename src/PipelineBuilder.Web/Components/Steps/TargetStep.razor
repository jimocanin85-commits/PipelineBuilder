@inject WizardState Wizard
@inject IDeploymentKinds DeploymentKinds

<h2>Where does it run?</h2>

<div class="fields">
    <div>
        <label for="environments">Environments, in order</label>
        <InputText id="environments" @bind-Value="Wizard.EnvironmentsCsv" class="form-control" placeholder="test, prod" />
    </div>
    <div>
        <label for="release-branch">Release branch</label>
        <InputText id="release-branch" @bind-Value="Wizard.Definition.ReleaseBranch" class="form-control" placeholder="main" />
        <p class="hint">Only this branch deploys to <code>prod</code>.</p>
    </div>
</div>

<h3>@KindTitle</h3>
<div class="fields">
    @switch (Wizard.Definition.Deployment.Kind)
    {
        case DeploymentKind.Iis:
            <div>
                <label for="website">IIS website</label>
                <InputText id="website" @bind-Value="Wizard.Definition.Deployment.WebsiteName" class="form-control" placeholder="Default Web Site" />
            </div>
            break;
        case DeploymentKind.WindowsService:
        case DeploymentKind.LinuxService:
            <div>
                <label for="service">Service name</label>
                <InputText id="service" @bind-Value="Wizard.Definition.Deployment.ServiceName" class="form-control" placeholder="$(SERVICE_NAME)" />
            </div>
            <div>
                <label for="install-path">Install folder</label>
                <InputText id="install-path" @bind-Value="Wizard.Definition.Deployment.TargetPath" class="form-control" placeholder="@InstallFolderExample" />
            </div>
            break;
        case DeploymentKind.FileShare:
            <div>
                <label for="share">Target folder or share</label>
                <InputText id="share" @bind-Value="Wizard.Definition.Deployment.TargetPath" class="form-control" placeholder="\\server\share\app" />
            </div>
            break;
        case DeploymentKind.DockerContainer:
            <div>
                <label for="server-os">Servers run</label>
                <InputSelect id="server-os" @bind-Value="Wizard.Definition.Deployment.ServerOs" class="form-control">
                    <option value="@ServerOs.Linux">Linux</option>
                    <option value="@ServerOs.Windows">Windows</option>
                </InputSelect>
            </div>
            <div>
                <label for="container">Container name</label>
                <InputText id="container" @bind-Value="Wizard.Definition.Deployment.ContainerName" class="form-control" placeholder="$(CONTAINER_NAME)" />
            </div>
            <div>
                <label for="container-ports">Ports (host:container)</label>
                <InputText id="container-ports" @bind-Value="Wizard.ContainerPorts" class="form-control" placeholder="8080:80" />
            </div>
            <div>
                <label for="registry-connection">Registry service connection</label>
                <InputText id="registry-connection" @bind-Value="Wizard.Definition.Artifact.ContainerRegistryConnection" class="form-control" placeholder="$(DOCKER_SERVICE_CONNECTION)" />
            </div>
            <div class="wide">
                <label for="container-env">Environment variables (one NAME=value per line)</label>
                <InputTextArea id="container-env" @bind-Value="Wizard.ContainerEnvironment" class="form-control" rows="3" />
            </div>
            break;
        case DeploymentKind.Kubernetes:
            <div>
                <label for="k8s-connection">Kubernetes service connection</label>
                <InputText id="k8s-connection" @bind-Value="Wizard.Definition.Deployment.KubernetesServiceConnection" class="form-control" placeholder="$(K8S_SERVICE_CONNECTION)" />
            </div>
            <div>
                <label for="k8s-namespace">Namespace</label>
                <InputText id="k8s-namespace" @bind-Value="Wizard.Definition.Deployment.KubernetesNamespace" class="form-control" placeholder="$(K8S_NAMESPACE)" />
            </div>
            <div>
                <label for="k8s-manifests">Manifests in the repository</label>
                <InputText id="k8s-manifests" @bind-Value="Wizard.Definition.Deployment.ManifestsPath" class="form-control" placeholder="manifests/*.yaml" />
            </div>
            <div>
                <label for="k8s-deployment">Deployment name</label>
                <InputText id="k8s-deployment" @bind-Value="Wizard.Definition.Deployment.KubernetesDeploymentName" class="form-control" placeholder="$(K8S_DEPLOYMENT)" />
            </div>
            <div>
                <label for="registry-connection">Registry service connection</label>
                <InputText id="registry-connection" @bind-Value="Wizard.Definition.Artifact.ContainerRegistryConnection" class="form-control" placeholder="$(DOCKER_SERVICE_CONNECTION)" />
            </div>
            break;
        default:
            <div>
                <label for="server-os">Servers run</label>
                <InputSelect id="server-os" @bind-Value="Wizard.Definition.Deployment.ServerOs" class="form-control">
                    <option value="@ServerOs.Windows">Windows (PowerShell)</option>
                    <option value="@ServerOs.Linux">Linux (bash)</option>
                </InputSelect>
            </div>
            <div class="wide">
                <label for="custom-script">Deploy script</label>
                <InputTextArea id="custom-script" @bind-Value="Wizard.Definition.Deployment.CustomScript" class="form-control" rows="4" />
            </div>
            break;
    }
</div>
<p class="hint">A field you leave empty becomes a pipeline variable; the Result step lists them.</p>

@if (DeploymentKinds.For(Wizard.Definition.Deployment.Kind).RunsOnServers)
{
    <label class="check"><InputCheckbox id="rolling" @bind-Value="Wizard.Rolling" /> Update the servers a few at a time</label>
    if (Wizard.Rolling)
    {
        <label for="batch">Servers at a time</label>
        <InputNumber id="batch" @bind-Value="Wizard.Definition.DeploymentStrategy.BatchSize" class="form-control narrow" />
    }
}

<details class="more">
    <summary>Build agent, branches and variables</summary>

    <h3>Build agent</h3>
    <label class="check"><InputCheckbox id="self-hosted" @bind-Value="SelfHosted" /> Build on our own agent pool</label>
    @if (SelfHosted)
    {
        <label for="pool-name">Agent pool</label>
        <InputText id="pool-name" @bind-Value="Wizard.Definition.PoolName" class="form-control" placeholder="Default" />
    }

    <h3>Branches that start the pipeline</h3>
    <label for="include-branches">Branches (comma-separated)</label>
    <InputText id="include-branches" @bind-Value="Wizard.IncludeBranches" class="form-control" placeholder="main, release/*" />
    <label for="path-filters">Only when these paths change (prefix with ! to exclude)</label>
    <InputText id="path-filters" @bind-Value="Wizard.PathFilters" class="form-control" placeholder="src/*, !docs/*" />

    <h3>Variable groups</h3>
    @foreach (var group in Wizard.VariableGroups)
    {
        <div class="card row">
            <InputText @bind-Value="group.Name" placeholder="vg-my-app" aria-label="Variable group name" />
            <select aria-label="Used by" value="@(group.Scope == VariableGroupScope.Environment ? group.EnvironmentName : "")"
                    @onchange="e => SetScope(group, e.Value?.ToString())">
                <option value="">Whole pipeline</option>
                @foreach (var env in Wizard.Definition.Environments)
                {
                    <option value="@env">Only @env</option>
                }
            </select>
            <label><InputCheckbox @bind-Value="group.ContainsSecrets" /> has secrets</label>
            <button type="button" class="btn-link" @onclick="() => { Wizard.VariableGroups.Remove(group); Wizard.NotifyChanged(); }">Remove</button>
        </div>
    }
    <button type="button" class="btn-secondary" id="add-variable-group" @onclick="AddGroup">Add variable group</button>

    <h3>Key Vault</h3>
    <label class="check"><InputCheckbox id="keyvault-enabled" @bind-Value="Wizard.KeyVaultEnabled" /> Load secrets from Azure Key Vault before deploying</label>
    @if (Wizard.KeyVaultEnabled)
    {
        <div class="fields">
            <div>
                <label for="kv-name">Key Vault name</label>
                <InputText id="kv-name" @bind-Value="Wizard.KeyVault.KeyVaultName" class="form-control" />
            </div>
            <div>
                <label for="azure-connection">Azure service connection</label>
                <InputText id="azure-connection" @bind-Value="Wizard.AzureServiceConnection" class="form-control" placeholder="$(AZURE_SERVICE_CONNECTION)" />
            </div>
        </div>
    }
</details>

@code {
    private string KindTitle => Wizard.Definition.Deployment.Kind switch
    {
        DeploymentKind.Iis => "IIS website",
        DeploymentKind.WindowsService => "Windows service",
        DeploymentKind.LinuxService => "Linux service",
        DeploymentKind.FileShare => "Files",
        DeploymentKind.DockerContainer => "Docker container",
        DeploymentKind.Kubernetes => "Kubernetes",
        _ => "Your own script"
    };

    private bool SelfHosted
    {
        get => Wizard.Definition.BuildAgent == BuildAgentType.SelfHosted;
        set => Wizard.Definition.BuildAgent = value ? BuildAgentType.SelfHosted : BuildAgentType.MicrosoftHosted;
    }

    private string InstallFolderExample =>
        Wizard.Definition.Deployment.Kind == DeploymentKind.LinuxService ? "/opt/my-app" : @"D:\apps\my-app";

    /// <summary>A group is used by the whole pipeline, or only by one environment's deploy stage.</summary>
    private void SetScope(VariableGroupConfig group, string? environment)
    {
        group.Scope = string.IsNullOrEmpty(environment) ? VariableGroupScope.Pipeline : VariableGroupScope.Environment;
        group.EnvironmentName = string.IsNullOrEmpty(environment) ? null : environment;
        Wizard.NotifyChanged();
    }

    private void AddGroup()
    {
        Wizard.VariableGroups.Add(new VariableGroupConfig { Name = "vg-" + Wizard.Definition.Name });
        Wizard.NotifyChanged();
    }
}
