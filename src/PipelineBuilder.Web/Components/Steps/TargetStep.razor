@inject WizardState Wizard
@inject IDeploymentKinds DeploymentKinds

<h2>Where does it run?</h2>

<h3>Environments</h3>
<ol class="order" id="environment-order">
    @foreach (var environment in Wizard.Definition.Environments)
    {
        <li><span>@environment</span></li>
    }
</ol>
<p class="hint">The pipeline deploys to them in this order, and stops when a deployment fails.</p>
<label class="check"><InputCheckbox id="skip-preprod" @bind-Value="Wizard.SkipPreprod" /> We have no preprod: go straight from test to prod</label>
<details class="explain">
    <summary>What is an environment?</summary>
    <p>@Help.Environment</p>
</details>

@* An approval between two environments. The first environment has nothing before it to wait for. *@
@for (var i = 1; i < Wizard.Definition.Environments.Count; i++)
{
    var before = Wizard.Definition.Environments[i - 1];
    var environment = Wizard.Definition.Environments[i];
    <label class="check">
        <input type="checkbox" id="@($"approve-{environment}")" checked="@Wizard.WaitsForApproval(environment)"
               @onchange="e => Wizard.SetApproval(environment, e.Value is true)" />
        Wait for approval between @before and @environment
    </label>
}
@if (Wizard.Definition.Environments.Skip(1).Any(Wizard.WaitsForApproval))
{
    <p class="hint">The pipeline stops there and sends an email. It goes on when an approver presses Resume, and stops for good when the waiting time is up.</p>
    <details class="explain">
        <summary>How is this different from an approval on the environment?</summary>
        <p>@Help.ApprovalInFile</p>
    </details>
    <div class="fields">
        <Field For="approvers" Label="Who may approve" Hint="Users or groups, comma-separated. Empty means everyone who may start the pipeline.">
            <InputText id="approvers" @bind-Value="Wizard.Definition.Approval.Approvers" class="form-control" placeholder="[Our project]\Release approvers" />
        </Field>
        <Field For="approval-notify" Label="Who gets the email" Hint="Users or groups, comma-separated.">
            <InputText id="approval-notify" @bind-Value="Wizard.Definition.Approval.NotifyUsers" class="form-control" placeholder="lead@contoso.com" />
        </Field>
        <Field For="approval-wait" Label="Hours to wait" Hint="Without an answer in that time, the deployment is rejected.">
            <InputNumber id="approval-wait" @bind-Value="Wizard.Definition.Approval.WaitHours" class="form-control narrow" />
        </Field>
    </div>
}

<h3>@KindTitle</h3>
@if (Wizard.Definition.Deployment.Kind == DeploymentKind.Ansible)
{
    <p class="hint">Your playbook runs once per environment, on a Linux agent that has Ansible installed and can reach your servers. Ansible does not run on Windows agents.</p>
}
<div class="fields">
    @switch (Wizard.Definition.Deployment.Kind)
    {
        case DeploymentKind.Iis:
            <Field For="website" Label="IIS website" Hint="The site's name in IIS Manager. Its files are replaced with the new version.">
                <InputText id="website" @bind-Value="Wizard.Definition.Deployment.WebsiteName" class="form-control" placeholder="Default Web Site" />
            </Field>
            break;
        case DeploymentKind.WindowsService:
        case DeploymentKind.LinuxService:
            <Field For="service" Label="Service name" Hint="The service is stopped, its files are replaced, and it is started again.">
                <InputText id="service" @bind-Value="Wizard.Definition.Deployment.ServiceName" class="form-control" placeholder="$(SERVICE_NAME)" />
            </Field>
            <Field For="install-path" Label="Install folder" Hint="The folder on the server that the service runs from.">
                <InputText id="install-path" @bind-Value="Wizard.Definition.Deployment.TargetPath" class="form-control" placeholder="@InstallFolderExample" />
            </Field>
            break;
        case DeploymentKind.FileShare:
            <Field For="share" Label="Target folder or share" Hint="The folder is made identical to the build: files that are no longer in the build are deleted.">
                <InputText id="share" @bind-Value="Wizard.Definition.Deployment.TargetPath" class="form-control" placeholder="\\server\share\app" />
            </Field>
            break;
        case DeploymentKind.DockerContainer:
            <Field For="server-os" Label="Servers run">
                <InputSelect id="server-os" @bind-Value="Wizard.Definition.Deployment.ServerOs" class="form-control">
                    <option value="@ServerOs.Linux">Linux</option>
                    <option value="@ServerOs.Windows">Windows</option>
                </InputSelect>
            </Field>
            <Field For="container" Label="Container name" Hint="A running container with this name is replaced by the new one.">
                <InputText id="container" @bind-Value="Wizard.Definition.Deployment.ContainerName" class="form-control" placeholder="$(CONTAINER_NAME)" />
            </Field>
            <Field For="container-ports" Label="Ports (host:container)" Hint="Without a port, nothing outside the server can reach the container.">
                <InputText id="container-ports" @bind-Value="Wizard.ContainerPorts" class="form-control" placeholder="8080:80" />
            </Field>
            <Field For="registry-connection" Label="Registry service connection" Hint="The connection's name, not the registry's address." More="@Help.ServiceConnection">
                <InputText id="registry-connection" @bind-Value="Wizard.Definition.Artifact.ContainerRegistryConnection" class="form-control" placeholder="$(DOCKER_SERVICE_CONNECTION)" />
            </Field>
            <Field For="container-env" Label="Environment variables" Wide="true"
                   Hint="One NAME=value per line. For a password, point to a secret variable instead of typing it: API_KEY=$(API_KEY).">
                <InputTextArea id="container-env" @bind-Value="Wizard.ContainerEnvironment" class="form-control" rows="3" />
            </Field>
            break;
        case DeploymentKind.Kubernetes:
            <Field For="k8s-connection" Label="Kubernetes service connection" Hint="The connection's name." More="@Help.ServiceConnection">
                <InputText id="k8s-connection" @bind-Value="Wizard.Definition.Deployment.KubernetesServiceConnection" class="form-control" placeholder="$(K8S_SERVICE_CONNECTION)" />
            </Field>
            <Field For="k8s-namespace" Label="Namespace" Hint="The namespace the manifests are applied to.">
                <InputText id="k8s-namespace" @bind-Value="Wizard.Definition.Deployment.KubernetesNamespace" class="form-control" placeholder="$(K8S_NAMESPACE)" />
            </Field>
            <Field For="k8s-manifests" Label="Manifests in the repository" Hint="Your Kubernetes YAML files. The image in them is swapped for the one built by this run.">
                <InputText id="k8s-manifests" @bind-Value="Wizard.Definition.Deployment.ManifestsPath" class="form-control" placeholder="manifests/*.yaml" />
            </Field>
            <Field For="k8s-deployment" Label="Deployment name" Hint="Used to roll back when a deployment fails.">
                <InputText id="k8s-deployment" @bind-Value="Wizard.Definition.Deployment.KubernetesDeploymentName" class="form-control" placeholder="$(K8S_DEPLOYMENT)" />
            </Field>
            <Field For="registry-connection" Label="Registry service connection" Hint="The connection's name, not the registry's address." More="@Help.ServiceConnection">
                <InputText id="registry-connection" @bind-Value="Wizard.Definition.Artifact.ContainerRegistryConnection" class="form-control" placeholder="$(DOCKER_SERVICE_CONNECTION)" />
            </Field>
            break;
        case DeploymentKind.Ansible:
            <Field For="playbook" Label="Playbook" Hint="Its path in your repository." More="@Help.AnsibleValues">
                <InputText id="playbook" @bind-Value="Wizard.Definition.Deployment.PlaybookPath" class="form-control" placeholder="site.yml" />
            </Field>
            <Field For="inventory" Label="Inventory" Hint="{environment} is replaced with each environment's name, so test and prod can have their own servers.">
                <InputText id="inventory" @bind-Value="Wizard.Definition.Deployment.InventoryPath" class="form-control" placeholder="inventories/{environment}" />
            </Field>
            <Field For="ansible-pool" Label="Linux agent pool" Hint="Fill it in when the build runs on a Windows agent. Empty means the build's agent.">
                <InputText id="ansible-pool" @bind-Value="Wizard.Definition.Deployment.AgentPool" class="form-control" />
            </Field>
            <Field For="ansible-key" Label="SSH key (secure file)" Hint="Empty means the agent already has a key for the servers." More="@Help.SecureFile">
                <InputText id="ansible-key" @bind-Value="Wizard.Definition.Deployment.AnsibleSshKeyFile" class="form-control" />
            </Field>
            break;
        default:
            <Field For="server-os" Label="Servers run">
                <InputSelect id="server-os" @bind-Value="Wizard.Definition.Deployment.ServerOs" class="form-control">
                    <option value="@ServerOs.Windows">Windows (PowerShell)</option>
                    <option value="@ServerOs.Linux">Linux (bash)</option>
                </InputSelect>
            </Field>
            <Field For="custom-script" Label="Deploy script" Wide="true" Hint="@CustomScriptHint">
                <InputTextArea id="custom-script" @bind-Value="Wizard.Definition.Deployment.CustomScript" class="form-control" rows="4" />
            </Field>
            break;
    }
</div>
@if (HasVariableFields)
{
    <p class="hint">@Help.EmptyField</p>
}

@if (DeploymentKinds.For(Wizard.Definition.Deployment.Kind).RunsOnServers)
{
    <h3>Who runs the deployment?</h3>
    <div class="fields">
        <Field For="run-from" Label="Deployed by" Hint="@RunFromHint">
            <InputSelect id="run-from" @bind-Value="Wizard.Definition.Deployment.RunFrom" class="form-control">
                <option value="@DeployFrom.Server">An agent on each server</option>
                <option value="@DeployFrom.Agent">Our build agent, over the network</option>
            </InputSelect>
        </Field>
        @if (FromAgent && LinuxServers)
        {
            <Field For="ssh-user" Label="SSH user" Hint="The account on the servers that the build agent logs in as.">
                <InputText id="ssh-user" @bind-Value="Wizard.Definition.Deployment.SshUser" class="form-control" placeholder="$(SSH_USER)" />
            </Field>
        }
    </div>
}

@if (DeploymentKinds.UsesServerResources(Wizard.Definition))
{
    <label class="check"><InputCheckbox id="rolling" @bind-Value="Wizard.Rolling" /> Update the servers a few at a time</label>
    <p class="hint">Keeps the app available while it is updated.</p>
    if (Wizard.Rolling)
    {
        <Field For="batch" Label="Servers at a time">
            <InputNumber id="batch" @bind-Value="Wizard.Definition.DeploymentStrategy.BatchSize" class="form-control narrow" />
        </Field>
    }
}

@{
    // A problem in a folded-away field opens the section; it then stays open while the user fixes it.
    _moreOpen |= HasProblemUnderMore;
}
<details class="more" open="@_moreOpen">
    <summary>More settings</summary>

    <h3>Environment names</h3>
    <Field For="environments" Label="Environments, in order" Hint="Change them only if yours are called something else. Use lowercase letters, digits and hyphens.">
        <InputText id="environments" @bind-Value="Wizard.EnvironmentsCsv" class="form-control" placeholder="test, preprod, prod" />
    </Field>

    <h3>Build agent</h3>
    <label class="check"><InputCheckbox id="self-hosted" @bind-Value="SelfHosted" /> Build on our own agent pool</label>
    <p class="hint">Needed when the build must reach things inside your network. Otherwise Microsoft's agents build.</p>
    @if (SelfHosted)
    {
        <Field For="pool-name" Label="Agent pool" Hint="Its name under Project settings → Agent pools.">
            <InputText id="pool-name" @bind-Value="Wizard.Definition.PoolName" class="form-control" placeholder="Default" />
        </Field>
    }

    <h3>Branches</h3>
    <Field For="release-branch" Label="Release branch" Hint="Only this branch deploys to prod. Other branches stop after the environments before it.">
        <InputText id="release-branch" @bind-Value="Wizard.Definition.ReleaseBranch" class="form-control" placeholder="main" />
    </Field>
    <Field For="include-branches" Label="Branches that start the pipeline" Hint="Comma-separated, e.g. main, release/*.">
        <InputText id="include-branches" @bind-Value="Wizard.IncludeBranches" class="form-control" placeholder="main, release/*" />
    </Field>
    <Field For="path-filters" Label="Only when these paths change" Hint="Optional. Put ! in front of a path to leave it out, e.g. src/*, !docs/*.">
        <InputText id="path-filters" @bind-Value="Wizard.PathFilters" class="form-control" placeholder="src/*, !docs/*" />
    </Field>

    <h3>Variable groups</h3>
    <p class="hint">@Help.VariableGroup</p>
    @foreach (var group in Wizard.VariableGroups)
    {
        <div class="card row">
            <InputText @bind-Value="group.Name" placeholder="vg-my-app" aria-label="Variable group name" />
            <select aria-label="Used by" value="@(group.Scope == VariableGroupScope.Environment ? group.EnvironmentName : "")"
                    @onchange="e => SetScope(group, e.Value?.ToString())">
                <option value="">Whole pipeline</option>
                @foreach (var env in Wizard.Definition.Environments)
                {
                    <option value="@env">Only @env</option>
                }
            </select>
            <label><InputCheckbox @bind-Value="group.ContainsSecrets" /> has secrets</label>
            <button type="button" class="btn-link" @onclick="() => { Wizard.VariableGroups.Remove(group); Wizard.NotifyChanged(); }">Remove</button>
        </div>
    }
    <button type="button" class="btn-secondary" id="add-variable-group" @onclick="AddGroup">Add variable group</button>

    <h3>Key Vault</h3>
    <label class="check"><InputCheckbox id="keyvault-enabled" @bind-Value="Wizard.KeyVaultEnabled" /> Load secrets from Azure Key Vault before deploying</label>
    <p class="hint">Each secret in the vault becomes a variable with the secret's name.</p>
    @if (Wizard.KeyVaultEnabled)
    {
        <div class="fields">
            <Field For="kv-name" Label="Key Vault name">
                <InputText id="kv-name" @bind-Value="Wizard.KeyVault.KeyVaultName" class="form-control" />
            </Field>
            <Field For="azure-connection" Label="Azure service connection" Hint="The connection's name." More="@Help.ServiceConnection">
                <InputText id="azure-connection" @bind-Value="Wizard.AzureServiceConnection" class="form-control" placeholder="$(AZURE_SERVICE_CONNECTION)" />
            </Field>
        </div>
    }
</details>

@code {
    private bool _moreOpen;

    private string KindTitle => Wizard.Definition.Deployment.Kind switch
    {
        DeploymentKind.Iis => "IIS website",
        DeploymentKind.WindowsService => "Windows service",
        DeploymentKind.LinuxService => "Linux service",
        DeploymentKind.FileShare => "Files",
        DeploymentKind.DockerContainer => "Docker container",
        DeploymentKind.Kubernetes => "Kubernetes",
        DeploymentKind.Ansible => "Ansible playbook",
        _ => "Your own script"
    };

    /// <summary>Kinds with fields that fall back to a pipeline variable when left empty.</summary>
    private bool HasVariableFields => Wizard.Definition.Deployment.Kind is not (DeploymentKind.Iis or DeploymentKind.Custom or DeploymentKind.Ansible);

    private bool FromAgent => DeploymentKinds.DeploysFromAgentToServers(Wizard.Definition);
    private bool LinuxServers => DeploymentKinds.ShellFor(Wizard.Definition) == ScriptShell.Bash;

    private string RunFromHint
    {
        get
        {
            if (!FromAgent)
                return "Each server has its own Azure DevOps agent and updates itself: Windows servers with Windows PowerShell, Linux servers with bash.";

            var how = LinuxServers
                ? "The build agent connects to each server with SSH, using its own SSH key."
                : "A Windows build agent connects to each server with PowerShell remoting (WinRM), as the account the agent runs as.";
            var docker = Wizard.Definition.Deployment.Kind == DeploymentKind.DockerContainer
                ? " Log each server in to your registry once with docker login."
                : string.Empty;
            return how + " The servers are updated one at a time, and are named in variables listed on the Result step." + docker;
        }
    }

    private string CustomScriptHint
    {
        get
        {
            var onAgent = $"$(Pipeline.Workspace)/{Wizard.Definition.Artifact.ArtifactName}";
            var build = FromAgent
                ? PipelineBuilder.Core.Yaml.ServerScript.RemotePackagePath(DeploymentKinds.ShellFor(Wizard.Definition), onAgent)
                : onAgent;
            return $"Runs on each server. The build is in {build}.";
        }
    }

    /// <summary>Settings under "More settings"; a problem in one of them must not stay hidden.</summary>
    private static readonly string[] FieldsUnderMore =
    {
        nameof(PipelineDefinition.Environments), nameof(PipelineDefinition.BuildAgent), nameof(PipelineDefinition.PoolName), nameof(PipelineDefinition.ReleaseBranch),
        nameof(PipelineDefinition.VariableGroups), nameof(PipelineDefinition.KeyVault)
    };

    private bool HasProblemUnderMore =>
        Wizard.IssuesFor(WizardStep.Target).Any(issue => issue.AffectedField is { } setting && FieldsUnderMore.Contains(setting));

    private bool SelfHosted
    {
        get => Wizard.Definition.BuildAgent == BuildAgentType.SelfHosted;
        set => Wizard.Definition.BuildAgent = value ? BuildAgentType.SelfHosted : BuildAgentType.MicrosoftHosted;
    }

    private string InstallFolderExample =>
        Wizard.Definition.Deployment.Kind == DeploymentKind.LinuxService ? "/opt/my-app" : @"D:\apps\my-app";

    /// <summary>A group is used by the whole pipeline, or only by one environment's deploy stage.</summary>
    private void SetScope(VariableGroupConfig group, string? environment)
    {
        group.Scope = string.IsNullOrEmpty(environment) ? VariableGroupScope.Pipeline : VariableGroupScope.Environment;
        group.EnvironmentName = string.IsNullOrEmpty(environment) ? null : environment;
        Wizard.NotifyChanged();
    }

    private void AddGroup()
    {
        Wizard.VariableGroups.Add(new VariableGroupConfig { Name = "vg-" + Wizard.Definition.Name });
        Wizard.NotifyChanged();
    }
}
