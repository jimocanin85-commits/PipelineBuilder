@inject WizardState Wizard

@* Beside every step: what the pipeline needs in Azure DevOps, or the file itself as it is now. *@
<div class="result">
    @if (Pipeline is { } pipeline)
    {
        // The Result step shows the file itself, so there the pane only lists what is needed.
        if (Wizard.CurrentStep != WizardStep.Result)
        {
            <div class="side-head">
                <div class="side-tabs" role="tablist" aria-label="Show">
                    <button type="button" class="side-tab" role="tab" data-tab="overview" aria-selected="@(ShowsFile ? "false" : "true")" @onclick="() => _file = false">Needs in Azure DevOps</button>
                    <button type="button" class="side-tab" role="tab" data-tab="file" aria-selected="@(ShowsFile ? "true" : "false")" @onclick="() => _file = true">YAML file</button>
                </div>
            </div>
        }
        if (ShowsFile)
        {
            <p class="live-note">@ResultStep.PipelineFileName as it is now. A line lights up when a setting changes it.</p>
            <YamlView Yaml="@pipeline.Yaml" Live="true" />
        }
        else
        {
            <ul class="needs-list">
                <li>Needs in Azure DevOps</li>
                @* Grouped by where in Azure DevOps each thing is created. *@
                @foreach (var place in pipeline.Requirements.GroupBy(need => need.Where))
                {
                    <li class="where">@place.Key</li>
                    foreach (var need in place)
                    {
                        <li data-need="@need.Kind">
                            <code>@need.Name</code>
                            <span class="what">@need.Purpose</span>
                            @if (need.IsSecret)
                            {
                                <span class="tag secret">secret</span>
                            }
                        </li>
                    }
                }
            </ul>
        }
    }
    else
    {
        <p class="hint">What the pipeline needs is listed here once the settings marked with ! are fixed.</p>
    }
</div>

@code {
    /// <summary>The generated pipeline. A parameter, so the pane is redrawn whenever the settings change.</summary>
    [Parameter] public GeneratedPipeline? Pipeline { get; set; }

    /// <summary>The pane shows the file instead of the list.</summary>
    private bool _file;

    private bool ShowsFile => _file && Wizard.CurrentStep != WizardStep.Result;
}
