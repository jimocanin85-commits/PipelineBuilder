@inject WizardState Wizard

<h2>Governance</h2>
<label><InputCheckbox @bind-Value="Wizard.Definition.Governance.RequiredApprovals" /> Remind me to add approvals to production environments</label>
<label><InputCheckbox @bind-Value="Wizard.Definition.Governance.RequireHealthCheck" /> Require a health check when deploying to prod</label>
<label><InputCheckbox @bind-Value="Wizard.Definition.Governance.RequireRollback" /> Require rollback for on-premises deployments</label>

<label for="naming">Pipeline naming convention (regular expression)</label>
<InputText id="naming" @bind-Value="Wizard.Definition.Governance.NamingConvention" class="form-control" placeholder="^[a-z0-9-]+$" />

<label for="required-groups">Required variable groups (comma-separated)</label>
<InputText id="required-groups" @bind-Value="Wizard.RequiredVariableGroups" class="form-control" />

<label for="forbidden-tasks">Forbidden tasks (comma-separated)</label>
<InputText id="forbidden-tasks" @bind-Value="Wizard.ForbiddenTasks" class="form-control" placeholder="CmdLine@2" />

<label for="required-tasks">Required tasks (comma-separated)</label>
<InputText id="required-tasks" @bind-Value="Wizard.RequiredTasks" class="form-control" />
