@page "/"
@rendermode InteractiveServer
@inject WizardState Wizard
@inject IPipelineGeneratorService Generator
@inject ITemplateCatalogue Templates
@inject IDeploymentKinds DeploymentKinds
@implements IDisposable

<PageTitle>PipelineBuilder</PageTitle>

<div class="wizard">
    <nav class="wizard-nav" aria-label="Steps">
        @foreach (var step in Enum.GetValues<WizardStep>())
        {
            <button type="button" class="step-btn @(Wizard.CurrentStep == step ? "active" : "") @(step < Wizard.CurrentStep ? "done" : "")"
                    data-step="@step" aria-current="@(Wizard.CurrentStep == step ? "step" : null)"
                    @onclick="() => GoTo(step)">
                <span class="step-no">@((int)step)</span>
                <span class="step-text">
                    <span class="step-title">@StepTitles.For(step)</span>
                    <span class="step-sum">@Chosen(step)</span>
                </span>
                @if (step != WizardStep.Result && Wizard.HasErrors(step))
                {
                    <span class="badge" title="This step has errors">!</span>
                }
            </button>
        }
    </nav>

    @* The step being filled in, and beside it the pipeline it produces. *@
    <div class="wizard-body">
    <section class="wizard-content">
        @if (Wizard.CurrentStep != WizardStep.Result)
        {
            <IssueList Issues="Wizard.IssuesFor(Wizard.CurrentStep)" />
        }
        @* Input* components need a cascading EditContext, so every step renders inside this form. *@
        <EditForm EditContext="CurrentEditContext">
            @* Keyed by the step, so opening a step draws it anew and it slides in. *@
            <div class="step-body" @key="Wizard.CurrentStep">
            @switch (Wizard.CurrentStep)
            {
                case WizardStep.Start:
                    <StartStep />
                    break;
                case WizardStep.Target:
                    <TargetStep />
                    break;
                case WizardStep.Safety:
                    <SafetyStep />
                    break;
                case WizardStep.Result:
                    <ResultStep Pipeline="Wizard.Result" />
                    break;
            }
            </div>
        </EditForm>

        <footer class="wizard-footer">
            <button type="button" class="btn-secondary" id="back" disabled="@(Wizard.CurrentStep == WizardStep.Start)" @onclick="Prev">Back</button>
            <button type="button" class="btn-primary" id="next" disabled="@(Wizard.CurrentStep == WizardStep.Result)" @onclick="Next">@NextLabel</button>
        </footer>
    </section>

    <aside class="wizard-side" aria-label="Your pipeline">
        <PipelineSummary Pipeline="Wizard.Result" />
    </aside>
    </div>
</div>

@code {
    private EditContext? _editContext;

    protected override void OnInitialized()
    {
        Wizard.NavigationRequested += OnNavigationRequested;
        Wizard.Changed += OnWizardChanged;
        Wizard.Generate(Generator);
    }

    public void Dispose()
    {
        Wizard.NavigationRequested -= OnNavigationRequested;
        Wizard.Changed -= OnWizardChanged;
        if (_editContext != null) _editContext.OnFieldChanged -= OnFieldChanged;
    }

    /// <summary>
    /// One EditContext per settings object. Field changes regenerate the pipeline and re-render the
    /// page, so the summary, the issue lists and the error badges stay current.
    /// </summary>
    private EditContext CurrentEditContext
    {
        get
        {
            if (_editContext?.Model != Wizard.Definition)
            {
                if (_editContext != null) _editContext.OnFieldChanged -= OnFieldChanged;
                _editContext = new EditContext(Wizard.Definition);
                _editContext.OnFieldChanged += OnFieldChanged;
            }
            return _editContext;
        }
    }

    private void OnFieldChanged(object? sender, FieldChangedEventArgs e)
    {
        Wizard.Generate(Generator);
        StateHasChanged();
    }

    private void OnWizardChanged() => InvokeAsync(() =>
    {
        Wizard.Generate(Generator);
        StateHasChanged();
    });

    private void OnNavigationRequested(WizardStep step)
    {
        GoTo(step);
        StateHasChanged();
    }

    /// <summary>One line under a step's name: what was chosen there, so the whole pipeline can be read off the steps.</summary>
    private string Chosen(WizardStep step) => step switch
    {
        WizardStep.Start => Templates.GetAllTemplates().FirstOrDefault(t => t.Id == Wizard.Definition.TemplateId)?.Name
                            ?? KindTitles.For(Wizard.Definition.Deployment.Kind),
        WizardStep.Target => string.Join(", ", Wizard.Definition.Environments),
        WizardStep.Safety => SafetyChosen(),
        _ => Wizard.Result != null ? "Ready" : "Not ready"
    };

    private string SafetyChosen()
    {
        var parts = new List<string>();
        if (Wizard.Definition.Rollback.Enabled && DeploymentKinds.For(Wizard.Definition.Deployment.Kind).SupportsRollback)
            parts.Add("Rollback");
        if (Wizard.HealthChecks.Count > 0)
            parts.Add(Wizard.HealthChecks.Count == 1 ? "1 health check" : $"{Wizard.HealthChecks.Count} health checks");
        if (Wizard.Notifications.Count > 0)
            parts.Add(Wizard.Notifications.Count == 1 ? "1 notification" : $"{Wizard.Notifications.Count} notifications");
        return parts.Count > 0 ? string.Join(", ", parts) : "Nothing yet";
    }

    /// <summary>The Next button says where it leads.</summary>
    private string NextLabel =>
        Wizard.CurrentStep == WizardStep.Result ? "Next" : $"Next: {StepTitles.For(Wizard.CurrentStep + 1)}";

    private void Prev() => GoTo((WizardStep)Math.Max((int)WizardStep.Start, (int)Wizard.CurrentStep - 1));
    private void Next() => GoTo((WizardStep)Math.Min((int)WizardStep.Result, (int)Wizard.CurrentStep + 1));

    private void GoTo(WizardStep step)
    {
        Wizard.CurrentStep = step;
        Wizard.Generate(Generator);
    }
}
