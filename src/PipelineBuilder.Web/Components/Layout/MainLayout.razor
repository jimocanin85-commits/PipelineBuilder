@inherits LayoutComponentBase

<div class="app-shell">
    <header class="app-header">
        <h1>
            <svg class="mark" viewBox="0 0 30 12" aria-hidden="true">
                <path d="M11 6h.5M18.5 6h2" stroke="currentColor" stroke-width="2" />
                <circle cx="6" cy="6" r="5" fill="currentColor" />
                <circle cx="15" cy="6" r="3.5" fill="none" stroke="currentColor" stroke-width="2" />
                <circle cx="24" cy="6" r="3.5" fill="none" stroke="currentColor" stroke-width="2" />
            </svg>
            PipelineBuilder
        </h1>
        <p class="tagline">Azure DevOps pipelines for your servers, Docker and Kubernetes</p>
        <div class="header-end">
            <AuthorizeView>
                <Authorized>
                    <p class="signed-in">Signed in as <strong>@context.User.Identity?.Name</strong></p>
                </Authorized>
            </AuthorizeView>
            @* js/theme.js listens for the click. *@
            <button type="button" class="theme-toggle" aria-label="Switch between light and dark">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2" />
                    <path d="M12 3a9 9 0 0 1 0 18z" fill="currentColor" />
                </svg>
            </button>
        </div>
    </header>
    <main class="app-main">
        @Body
    </main>
</div>
