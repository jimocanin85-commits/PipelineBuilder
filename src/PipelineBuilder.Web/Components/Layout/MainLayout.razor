@inherits LayoutComponentBase

<div class="app-shell">
    <header class="app-header">
        <h1>PipelineBuilder</h1>
        <p class="tagline">Azure DevOps pipelines for your servers, Docker and Kubernetes</p>
        <AuthorizeView>
            <Authorized>
                <p class="signed-in">Signed in as <strong>@context.User.Identity?.Name</strong></p>
            </Authorized>
        </AuthorizeView>
    </header>
    <main class="app-main">
        @Body
    </main>
</div>
