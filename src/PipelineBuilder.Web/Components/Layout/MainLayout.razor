@inherits LayoutComponentBase

<div class="app-shell">
    <header class="app-header">
        <h1>
            <svg class="mark" viewBox="0 0 30 12" aria-hidden="true">
                <path d="M6 6h18" stroke="currentColor" stroke-width="2" />
                <circle cx="6" cy="6" r="5" fill="currentColor" />
                <circle cx="15" cy="6" r="3.5" fill="var(--surface)" stroke="currentColor" stroke-width="2" />
                <circle cx="24" cy="6" r="3.5" fill="var(--surface)" stroke="currentColor" stroke-width="2" />
            </svg>
            PipelineBuilder
        </h1>
        <p class="tagline">Azure DevOps pipelines for your servers, Docker and Kubernetes</p>
        <AuthorizeView>
            <Authorized>
                <p class="signed-in">Signed in as <strong>@context.User.Identity?.Name</strong></p>
            </Authorized>
        </AuthorizeView>
    </header>
    <main class="app-main">
        @Body
    </main>
</div>
