@inject WizardState Wizard

<h2>Variable groups &amp; Key Vault</h2>
@foreach (var group in Wizard.VariableGroups)
{
    <div class="card row">
        <InputText @bind-Value="group.Name" placeholder="vg-test" aria-label="Variable group name" />
        <InputSelect @bind-Value="group.Scope" aria-label="Scope">
            @foreach (var s in Enum.GetValues<VariableGroupScope>())
            {
                <option value="@s">@s</option>
            }
        </InputSelect>
        @if (group.Scope == VariableGroupScope.Environment)
        {
            <InputSelect @bind-Value="group.EnvironmentName" aria-label="Environment">
                <option value="">(choose environment)</option>
                @foreach (var env in Wizard.Definition.Environments)
                {
                    <option value="@env">@env</option>
                }
            </InputSelect>
        }
        <label><InputCheckbox @bind-Value="group.ContainsSecrets" /> secrets</label>
        <button type="button" class="btn-link" @onclick="() => { Wizard.VariableGroups.Remove(group); Wizard.NotifyChanged(); }">Remove</button>
    </div>
}
<button type="button" class="btn-secondary" @onclick="Add">Add variable group</button>
<p class="hint">Stage scope is treated like pipeline scope; environment scope applies only to that environment's deploy stage.</p>

<h3>Azure Key Vault</h3>
<label><InputCheckbox @bind-Value="Wizard.KeyVaultEnabled" /> Load secrets from Key Vault in every deploy job</label>
@if (Wizard.KeyVaultEnabled)
{
    <div class="card">
        <label for="kv-name">Key Vault name</label>
        <InputText id="kv-name" @bind-Value="Wizard.KeyVault.KeyVaultName" class="form-control" placeholder="my-keyvault" />
        <label for="kv-filter">Secrets to load (comma-separated, * for all)</label>
        <InputText id="kv-filter" @bind-Value="Wizard.KeyVault.SecretsFilter" class="form-control" />
    </div>
}

@code {
    private void Add()
    {
        Wizard.VariableGroups.Add(new VariableGroupConfig { Name = "vg-new" });
        Wizard.NotifyChanged();
    }
}
