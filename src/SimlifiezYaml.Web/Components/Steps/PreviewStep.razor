@inject WizardState Wizard

<h2>YAML preview</h2>
@if (Wizard.BlockingErrors.Count > 0)
{
    <div class="generation-error">
        <p class="severity-error">The pipeline could not be generated. Fix these settings:</p>
        <IssueList Issues="Wizard.BlockingErrors" ShowGoTo="true" />
    </div>
}
else if (Wizard.Result is { } result)
{
    var errors = result.ValidationResults.Count(v => v.Severity == ValidationSeverity.Error);
    var warnings = result.ValidationResults.Count(v => v.Severity == ValidationSeverity.Warning);
    if (errors + warnings > 0)
    {
        <p class="@(errors > 0 ? "severity-error" : "severity-warning")">@errors error(s) and @warnings warning(s): see the Validation step.</p>
    }

    <h3>Stages</h3>
    <ul class="dep-graph">
        @foreach (var n in Wizard.DependencyGraph.Nodes)
        {
            <li><strong>@n.DisplayName</strong> @(n.DependsOn.Count > 0 ? $"← after {string.Join(", ", n.DependsOn)}" : "") @(n.ManualPromotion ? "(approval recommended)" : "")</li>
        }
    </ul>

    <pre class="yaml-preview">@result.Yaml</pre>

    @if (result.Explanations.Count > 0)
    {
        <details>
            <summary>What each task does (@result.Explanations.Count)</summary>
            <ul>
                @foreach (var ex in result.Explanations.DistinctBy(e => e.TaskName))
                {
                    <li><code>@ex.TaskName</code>: @ex.Explanation</li>
                }
            </ul>
        </details>
    }
}
