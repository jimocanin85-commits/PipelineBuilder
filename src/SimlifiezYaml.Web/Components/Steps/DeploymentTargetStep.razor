@inject WizardState Wizard
@inject IDeploymentStrategyService Strategies

<h2>Deployment</h2>
<label for="target">Where the app runs</label>
<InputSelect id="target" @bind-Value="Wizard.Definition.DeploymentTarget" class="form-control">
    @foreach (var d in Enum.GetValues<DeploymentTarget>())
    {
        <option value="@d">@d</option>
    }
</InputSelect>

<label for="kind">Deploy as</label>
<InputSelect id="kind" @bind-Value="Wizard.Definition.Deployment.Kind" class="form-control">
    @foreach (var k in Enum.GetValues<DeploymentKind>())
    {
        <option value="@k">@k</option>
    }
</InputSelect>

@switch (Wizard.Definition.Deployment.Kind)
{
    case DeploymentKind.Iis:
        <label for="website">IIS website name</label>
        <InputText id="website" @bind-Value="Wizard.Definition.Deployment.WebsiteName" class="form-control" placeholder="Default Web Site" />
        break;
    case DeploymentKind.WindowsService:
        <label for="service">Service name</label>
        <InputText id="service" @bind-Value="Wizard.Definition.Deployment.ServiceName" class="form-control" placeholder="$(SERVICE_NAME)" />
        <label for="install-path">Install folder</label>
        <InputText id="install-path" @bind-Value="Wizard.Definition.Deployment.TargetPath" class="form-control" placeholder="$(DEPLOY_PATH)" />
        break;
    case DeploymentKind.FileShare:
        <label for="share">Target folder or share</label>
        <InputText id="share" @bind-Value="Wizard.Definition.Deployment.TargetPath" class="form-control" placeholder="\\server\share\app" />
        break;
    case DeploymentKind.AzureAppService:
        <label for="webapp">App Service name</label>
        <InputText id="webapp" @bind-Value="Wizard.Definition.Deployment.WebAppName" class="form-control" placeholder="$(WEBAPP_NAME)" />
        break;
    case DeploymentKind.DockerContainer:
        <label for="container">Container name</label>
        <InputText id="container" @bind-Value="Wizard.Definition.Deployment.ContainerName" class="form-control" placeholder="$(CONTAINER_NAME)" />
        <p class="hint">The image is pulled from <code>$(DOCKER_REGISTRY)</code>; define that variable in a variable group.</p>
        break;
    case DeploymentKind.Kubernetes:
        <label for="k8s-connection">Kubernetes service connection</label>
        <InputText id="k8s-connection" @bind-Value="Wizard.Definition.Deployment.KubernetesServiceConnection" class="form-control" placeholder="$(K8S_SERVICE_CONNECTION)" />
        <label for="k8s-namespace">Namespace</label>
        <InputText id="k8s-namespace" @bind-Value="Wizard.Definition.Deployment.KubernetesNamespace" class="form-control" placeholder="$(K8S_NAMESPACE)" />
        <label for="k8s-manifests">Manifest files in the repository</label>
        <InputText id="k8s-manifests" @bind-Value="Wizard.Definition.Deployment.ManifestsPath" class="form-control" placeholder="manifests/*.yaml" />
        <label for="k8s-deployment">Deployment name (used to roll back)</label>
        <InputText id="k8s-deployment" @bind-Value="Wizard.Definition.Deployment.KubernetesDeploymentName" class="form-control" placeholder="$(K8S_DEPLOYMENT)" />
        <p class="hint">Use a Docker image artifact; the manifests get the image built by the run (<code>$(DOCKER_REGISTRY)/name:BuildId</code>).</p>
        break;
    default:
        <label for="custom-script">Deploy script (PowerShell)</label>
        <InputTextArea id="custom-script" @bind-Value="Wizard.Definition.Deployment.CustomScript" class="form-control" rows="4" placeholder="Your deploy commands" />
        break;
}

<h3>Strategy</h3>
<InputSelect @bind-Value="Wizard.Definition.DeploymentStrategy.StrategyType" class="form-control">
    @foreach (var s in Enum.GetValues<DeploymentStrategyType>())
    {
        <option value="@s">@s</option>
    }
</InputSelect>
@switch (Wizard.Definition.DeploymentStrategy.StrategyType)
{
    case DeploymentStrategyType.Rolling:
        <label for="batch">Servers updated at a time</label>
        <InputNumber id="batch" @bind-Value="Wizard.Definition.DeploymentStrategy.BatchSize" class="form-control" />
        break;
    case DeploymentStrategyType.Canary:
        <label for="canary">Canary traffic (%)</label>
        <InputNumber id="canary" @bind-Value="Wizard.Definition.DeploymentStrategy.CanaryPercentage" class="form-control" />
        break;
    case DeploymentStrategyType.SlotSwap:
        <label for="slot">Staging slot name</label>
        <InputText id="slot" @bind-Value="Wizard.Definition.DeploymentStrategy.SlotName" class="form-control" placeholder="staging" />
        break;
}
<p class="hint">@Strategies.GetStrategyNote(Wizard.Definition.DeploymentStrategy)</p>

<h3>Infrastructure as code</h3>
<label><InputCheckbox @bind-Value="Wizard.IaCEnabled" /> Provision infrastructure in each environment before deploying</label>
@if (Wizard.IaCEnabled)
{
    <div class="card">
        <label for="iac-tool">Tool</label>
        <InputSelect id="iac-tool" @bind-Value="Wizard.IaC.Tool" class="form-control">
            @foreach (var t in Enum.GetValues<IaCTool>())
            {
                <option value="@t">@t</option>
            }
        </InputSelect>
        <label for="iac-dir">Working directory</label>
        <InputText id="iac-dir" @bind-Value="Wizard.IaC.WorkingDirectory" class="form-control" placeholder="infra" />
        <label><InputCheckbox @bind-Value="Wizard.IaC.PlanOnly" /> Plan only (never apply)</label>
        <label><InputCheckbox @bind-Value="Wizard.IaC.ApplyOnApproval" /> Gate infrastructure changes with the environment's approvals</label>
    </div>
}

<div class="info-box">Empty fields use pipeline variables (shown as placeholders), which you can define in a variable group.</div>
