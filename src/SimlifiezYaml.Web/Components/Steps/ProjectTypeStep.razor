@inject WizardState Wizard

<h2>Project</h2>

<div class="card load-settings">
    <label for="settings-file">Open saved settings (@PipelineDefinitionSerializer.FileName)</label>
    <InputFile id="settings-file" accept=".json,application/json" OnChange="LoadSettings" />
    @if (Wizard.SettingsMessage is { } message)
    {
        <p class="@(message.IsError ? "severity-error" : "status")" role="status">@message.Text</p>
    }
</div>

<label for="pipeline-name">Pipeline name</label>
<InputText id="pipeline-name" @bind-Value="Wizard.Definition.Name" class="form-control" />

<label for="project-type">Project type</label>
<InputSelect id="project-type" @bind-Value="Wizard.Definition.ProjectType" class="form-control">
    @foreach (var pt in Enum.GetValues<ProjectType>())
    {
        <option value="@pt">@pt</option>
    }
</InputSelect>

@if (Wizard.Definition.ProjectType == ProjectType.DotNet)
{
    <label for="project-path">Project(s) to build and publish</label>
    <InputText id="project-path" @bind-Value="Wizard.Definition.DotNetProjectPath" class="form-control" placeholder="**/*.csproj" />
    <p class="hint">Leave as <code>**/*.csproj</code> to publish all web projects, or point to one project, e.g. <code>src/MyApp/MyApp.csproj</code>.</p>

    <label for="test-path">Test projects</label>
    <InputText id="test-path" @bind-Value="Wizard.Definition.TestProjectPath" class="form-control" placeholder="**/*Tests*.csproj" />
}
else if (Wizard.Definition.ProjectType == ProjectType.Node)
{
    <label for="node-version">Node.js version</label>
    <InputText id="node-version" @bind-Value="Wizard.Definition.NodeVersion" class="form-control" placeholder="24.x" />
    <label for="node-output">Build output folder</label>
    <InputText id="node-output" @bind-Value="Wizard.Definition.NodeOutputFolder" class="form-control" placeholder="dist" />
    <p class="hint">The pipeline runs <code>npm ci</code>, <code>npm run build</code> and <code>npm run test</code> (each only if the script exists) and deploys the output folder.</p>
}
else
{
    <div class="info-box">Build and test steps for @Wizard.Definition.ProjectType projects are generated as placeholders for you to fill in.</div>
}

@code {
    private async Task LoadSettings(InputFileChangeEventArgs e)
    {
        try
        {
            await using var stream = e.File.OpenReadStream(PipelineDefinitionSerializer.MaxFileSize);
            using var reader = new StreamReader(stream);
            var definition = PipelineDefinitionSerializer.FromJson(await reader.ReadToEndAsync());
            Wizard.SettingsMessage = ($"Loaded settings for '{definition.Name}'.", false);
            Wizard.Load(definition);
        }
        catch (Exception ex) when (ex is FormatException or IOException)
        {
            Wizard.SettingsMessage = ($"Could not open the file: {ex.Message}", true);
        }
    }
}
